# ===========================================================================
# backup.env.example — configuration for scripts/backup.sh and restore.sh
#
# Copy to scripts/backup.env and edit, OR set any of these as real environment
# variables, OR pass a file with --env-file <path>. Every value has a sensible
# default (DB creds fall back to pacod-api/.env), so this file is entirely
# optional — it exists to document and override.
#
# Precedence:  real environment  >  this file  >  pacod-api/.env  >  built-in default
# ===========================================================================

# --- Destination -------------------------------------------------------------
# Where timestamped archives are written. Each run produces one owner-only
# (chmod 600) pacod-backup-<UTC-timestamp>.tar.gz here.
# BACKUP_DIR=./backups

# Delete pacod-backup-*.tar.gz older than N days after a successful backup.
# 0 (default) = never prune.
BACKUP_RETENTION_DAYS=10

# --- Docker / Compose --------------------------------------------------------
# COMPOSE_FILE=./pacod-api/docker-compose.yml
# COMPOSE_PROJECT_NAME=pacod

# --- PostgreSQL --------------------------------------------------------------
# Credentials + DB names. Default: read from ENV_FILE (pacod-api/.env), else the
# conventional values below. Override here only if your deployment differs.
# ENV_FILE=./pacod-api/.env
# POSTGRES_USER=pacod
# POSTGRES_PASSWORD=            # default: from ENV_FILE
# POSTGRES_DB=pacod
# POSTGRES_OPENWEBUI_DB=openwebui
# POSTGRES_ID_DB=pacod_id

# --- Qdrant ------------------------------------------------------------------
# REST endpoint reachable from where the script runs. On the Docker host the
# stack publishes 6333, so localhost works. Override if remote / behind a proxy.
# QDRANT_URL=http://localhost:6333

# --- What to include ---------------------------------------------------------
# Document/upload volume + Open-WebUI data dir (authoritative uploaded files).
# BACKUP_INCLUDE_DOCUMENTS=true

# Redis (sessions, rolling conversation summaries, caches). Semi-ephemeral —
# nothing authoritative lives only here, so it's OFF by default.
# BACKUP_INCLUDE_REDIS=false

# --- Advanced: compose service names / mount points --------------------------
# Only needed if you renamed services or remapped mounts in a custom compose.
# SVC_POSTGRES=postgres
# SVC_REDIS=redis
# SVC_DOCUMENTS=api
# SVC_OPENWEBUI=open-webui
# DOCUMENTS_MOUNT=/srv/documents
# OPENWEBUI_MOUNT=/app/backend/data
# REDIS_MOUNT=/data

# --- Remote copy (optional) --------------------------------------------------
# When REMOTE_HOST is set, the finished archive is also copied there with scp
# (REMOTE_USER@REMOTE_HOST:REMOTE_DIR). Blank = keep it local only.
REMOTE_USER=
REMOTE_HOST=
REMOTE_DIR=
