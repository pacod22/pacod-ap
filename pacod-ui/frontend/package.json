{
	"name": "app-shell-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-searchparam cookie preferredLanguage baseLocale",
		"check": "npm run compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@pacod/id-client": "file:vendor/pacod-id-client-0.1.0.tgz",
		"@pacod/id-sveltekit": "file:vendor/pacod-id-sveltekit-0.1.0.tgz",
		"@tanstack/svelte-query": "^5.62.0",
		"@xyflow/svelte": "^1.7.0",
		"chart.js": "^4.5.1",
		"dompurify": "^3.4.15",
		"ioredis": "^5.4.1",
		"marked": "^18.0.4",
		"prom-client": "^15.1.3",
		"uqr": "^0.1.3",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.20.2",
		"@playwright/test": "^1.49.0",
		"@sveltejs/adapter-node": "^5.2.10",
		"@sveltejs/kit": "^2.15.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.10.2",
		"clsx": "^2.1.1",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"lucide-svelte": "^0.469.0",
		"openapi-typescript": "^7.4.4",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.25.0",
		"svelte-check": "^4.1.1",
		"tailwind-merge": "^2.5.5",
		"tailwind-variants": "^0.3.0",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.0",
		"vite": "^6.0.5",
		"vitest": "^2.1.8"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
