# ============================================================
# Frontend environment variables — LOCAL DEVELOPMENT
#
# Copy this file to .env (already done) and fill in real values.
#
# Everything here is read SERVER-SIDE via $env/dynamic/private. This project
# uses no PUBLIC_* variables and no $env/static/public — values that the browser
# needs are read on the server and passed down through a `load` (see
# src/lib/server/site-config.ts). That is deliberate: $env/static/public bakes at
# build time, and one image serves every deployment.
#
# For the full combined stack these are set in pacod-api/docker-compose.yml's
# `frontend` `environment:` block, with values interpolated from pacod-api/.env.
# Nothing strips an APP_ prefix.
#
# The SEO / social / advertising keys carry the PACOD_ prefix, as in
# pacod-api/.env (see that file's KEY REFERENCE). Under `npm run dev`,
# vite.config.ts copies them onto the neutral names the app reads;
# src/lib/server/site-env.ts holds the key list.
# ============================================================

# Note: API base path (/api) and Open-WebUI path (/chat) are hardcoded — they are
# fixed by Caddy routing and must not vary between environments.

# --- Private (server-only) -------------------------------------
# Python backend URL (server-to-server calls from SvelteKit).
# In the combined Docker stack this is http://api:8000 (set via
# API_INTERNAL_URL in the docker-compose environment).
API_INTERNAL_URL="http://api:8000"

# Public URL of the Open-WebUI instance (used by the frontend shell link and by
# Open-WebUI itself for Socket.IO origin validation). Both services read this
# via the OPENWEBUI_URL variable in docker-compose.
OPENWEBUI_URL=https://ctest.local:3000

# Secret used by Open-WebUI to sign JWTs. Must be stable across restarts so
# tokens stay valid. Generate with: openssl rand -base64 32
WEBUI_SECRET_KEY=

# Open-WebUI admin account bootstrapped on first run. SvelteKit reads these
# to sign in as admin and find/create per-user accounts for SSO.
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=

# Session cookie signing secret (generate with: openssl rand -base64 32)
# Set as SESSION_SECRET in the combined docker-compose.
SESSION_SECRET=

# Dev only — proxy target for /api during `npm run dev` (Vite).
VITE_API_PROXY_TARGET="http://localhost:8000"

# --- Interface languages ---------------------------------------------------
# Which UI locales the language switchers offer (CSV of en, bg, de, ru).
# Every locale stays compiled in and English stays the base locale; this only
# narrows the choice. Unknown codes are ignored; blank → all four.
ENABLED_LOCALES="en,bg,de,ru"

# --- Crawler monitoring ----------------------------------------------------
# Full documentation in pacod-api/.env.example. The frontend is the only tier
# that sees crawler traffic, so classification happens here; rows are posted to
# admin-api in batches.
# false disables the crawler counter, the stored rows and all DNS — but keeps
# the `user_type="bot"` split on the existing request counter.
CRAWLER_TRACKING_ENABLED=true
# Reverse-DNS verification. Leave false for local dev so `npm run dev` makes no
# outbound DNS queries.
CRAWLER_VERIFY_ENABLED=false
# Blank locally: with no token the sink skips posting, so the counter still
# works and nothing is written. Must match the api's value in production.
CRAWLER_INGEST_TOKEN=

# --- Site identity, SEO, social and advertising (PACOD_ → neutral names) ----
# Blank means off: an unset id renders no tag and loads no script. Keep
# indexing off for local development.
PACOD_SITE_URL=
PACOD_SITE_NAME=
PACOD_SITE_OG_IMAGE=
PACOD_SITE_INDEXING_ENABLED=false
PACOD_SOCIAL_FACEBOOK_URL=
PACOD_SOCIAL_INSTAGRAM_URL=
PACOD_SOCIAL_YOUTUBE_URL=
PACOD_SOCIAL_TIKTOK_URL=
PACOD_SOCIAL_X_URL=
PACOD_SOCIAL_LINKEDIN_URL=
PACOD_SOCIAL_PINTEREST_URL=
PACOD_SOCIAL_X_HANDLE=
PACOD_SOCIAL_WHATSAPP_NUMBER=
PACOD_SOCIAL_WHATSAPP_TEXT=
PACOD_GOOGLE_SITE_VERIFICATION=
PACOD_BING_SITE_VERIFICATION=
PACOD_YANDEX_SITE_VERIFICATION=
PACOD_PINTEREST_SITE_VERIFICATION=
PACOD_FACEBOOK_DOMAIN_VERIFICATION=
PACOD_TIKTOK_SITE_VERIFICATION=
PACOD_GTM_ID=
PACOD_GA_MEASUREMENT_ID=
PACOD_GOOGLE_ADS_ID=
PACOD_GOOGLE_ADS_CONVERSION_LABEL=
PACOD_META_PIXEL_ID=
PACOD_META_APP_ID=
PACOD_TIKTOK_PIXEL_ID=
PACOD_X_PIXEL_ID=
PACOD_X_EVENT_IDS=
PACOD_YANDEX_METRICA_ID=
PACOD_MS_UET_TAG_ID=
PACOD_MS_CLARITY_ID=
PACOD_PINTEREST_TAG_ID=
PACOD_LINKEDIN_PARTNER_ID=
PACOD_LINKEDIN_CONVERSION_IDS=
PACOD_INDEXNOW_KEY=
PACOD_YOUTUBE_EMBED_ENABLED=
