# Monitoring module configuration.
#
# Copy to `.env` (`cp .env.example .env`) and adjust. All values have working
# defaults for SAME-INSTANCE deployment (Prometheus scrapes app + exporters by
# Docker DNS over the shared `agent-net` network).
#
# For a SEPARATE-INSTANCE monitoring server, point every *_TARGET at the app
# host's published exporter/app ports (e.g. API_TARGET=10.0.0.5:8000). See README.

# ---- Grafana ----
GRAFANA_PORT=3300
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ---- Prometheus / Alertmanager (bound to localhost by default) ----
# Not 9090 on the host: that port is often taken by another local Prometheus or API.
PROMETHEUS_PORT=9095
ALERTMANAGER_PORT=9093

# ---- Postgres exporter DSN ----
# Must match POSTGRES_* in pacod-api/.env. Connects to Postgres DIRECTLY (not
# PgBouncer). A read-only monitoring role is preferable in production.
POSTGRES_USER=pacod
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=pacod

# ---- Scrape targets (host:port) ----
# Defaults are Docker service names on `agent-net` (same-instance).
# App services (expose /metrics on their own port):
API_TARGET=api:8000
ADMIN_API_TARGET=admin-api:8000
MCP_TARGET=mcp-server:8000
EMBEDDINGS_TARGET=embeddings:8080
INGESTION_TARGET=ingestion:8000
# Edge (Caddy built-in metrics on its internal :9180 listener) + web (SvelteKit
# frontend /internal/metrics — registered-vs-anonymous split + active sessions):
CADDY_TARGET=caddy:9180
FRONTEND_TARGET=frontend:3000
# Native /metrics (no exporter):
QDRANT_TARGET=qdrant:6333
# The LLM gateway's core (over pacod-link) and the identity provider:
GW_CORE_TARGET=gw-core:9100
PACOD_ID_TARGET=pacod-id:9170
# Infra exporters (from docker-compose.exporters.yml):
POSTGRES_EXPORTER_TARGET=postgres-exporter:9187
PGBOUNCER_EXPORTER_TARGET=pgbouncer-exporter:9127
REDIS_EXPORTER_TARGET=redis-exporter:9121
NODE_EXPORTER_TARGET=node-exporter:9100
CADVISOR_TARGET=cadvisor:8080
