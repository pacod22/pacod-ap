# Monitoring module configuration.
#
# Copy to `.env` (`cp .env.example .env`) and adjust. All values have working
# defaults for SAME-INSTANCE deployment (Prometheus scrapes app + exporters by
# Docker DNS over the shared `pacod-net` network).
#
# For a SEPARATE-INSTANCE monitoring server, point every *_TARGET at the app
# host's published exporter/app ports (e.g. API_TARGET=10.0.0.5:8000). See README.

# ---- Grafana ----
GRAFANA_PORT=3300
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ---- Prometheus / Alertmanager (bound to localhost by default) ----
# Not 9090 on the host: that port is often taken by another local Prometheus or API.
PROMETHEUS_PORT=9095
ALERTMANAGER_PORT=9093

# ---- Postgres exporter DSN ----
# Must match POSTGRES_* in pacod-api/.env. Connects to Postgres DIRECTLY (not
# PgBouncer). A read-only monitoring role is preferable in production.
POSTGRES_USER=pacod
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=pacod

# ---- Scrape targets (host:port) ----
# Defaults are Docker service names on `pacod-net` (same-instance).
# pacod-ap's services (expose /metrics on their own port; ../platform/prometheus/ap.yml):
API_TARGET=ap-api:8000
ADMIN_API_TARGET=ap-admin-api:8000
MCP_TARGET=ap-mcp:8000
EMBEDDINGS_TARGET=pacod-embeddings:8080
INGESTION_TARGET=ap-ingestion:8000
# Web (SvelteKit frontend /internal/metrics — registered-vs-anonymous split + active sessions):
FRONTEND_TARGET=ap-frontend:3000
# pacod-ap's store exporters (from docker-compose.exporters.yml):
PGBOUNCER_EXPORTER_TARGET=ap-pgbouncer-exporter:9127
REDIS_EXPORTER_TARGET=ap-redis-exporter:9121
# The platform: the edge (Caddy built-in metrics on its internal :9180 listener):
CADDY_TARGET=pacod-caddy:9180
# Native /metrics (no exporter):
QDRANT_TARGET=pacod-qdrant:6333
# The LLM gateway's core and the identity provider:
GW_CORE_TARGET=pacod-gw:9100
PACOD_ID_TARGET=pacod-id:9170
# Platform exporters (from docker-compose.exporters.yml):
POSTGRES_EXPORTER_TARGET=pacod-postgres-exporter:9187
NODE_EXPORTER_TARGET=pacod-node-exporter:9100
CADVISOR_TARGET=pacod-cadvisor:8080
