{
  "uid": "pacod-web",
  "title": "pacod \u2014 Web traffic",
  "tags": [
    "pacod"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Edge request rate (req/s) by handler \u2014 all web traffic (Caddy)",
      "description": "Caddy sees 100% of edge traffic across every vhost, including anonymous marketing pages and static assets that never reach the API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (handler) (rate(caddy_http_requests_total{handler!=\"metrics\"}[5m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by site & user type (req/s) \u2014 frontend",
      "description": "registered vs anonymous vs bot. Crawlers used to be counted as anonymous, which inflated the apparent human figure \u2014 `bot` is now split out by the same counter (see the Crawlers dashboard for the breakdown by engine). Split by `site` (the frontend's prom-client default label).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (site, user_type) (rate(pacod_frontend_http_requests_total[5m]))",
          "legendFormat": "{{site}} \u00b7 {{user_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Edge error rate (5xx %) \u2014 Caddy",
      "description": "Status code lives on the duration histogram's _count series (caddy_http_requests_total has no code label). Excludes the internal metrics handler.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\", handler!=\"metrics\"}[5m])) / clamp_min(sum(rate(caddy_http_request_duration_seconds_count{handler!=\"metrics\"}[5m])), 1e-9)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Edge request latency p50 / p95 / p99 (Caddy)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Signed-in sessions (live)",
      "description": "Live server-side sessions (pacod_frontend_active_sessions): each lasts up to 30 days while it can be renewed, so this is not users online now. Distinct DAU/MAU is a DB/audit query, not Prometheus. max(), not sum(): every frontend replica shares one Redis session store and reports the SAME global count, so summing would multiply it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pacod_frontend_active_sessions)",
          "legendFormat": "sessions"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Registered share of frontend requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pacod_frontend_http_requests_total{user_type=\"registered\"}[5m])) / clamp_min(sum(rate(pacod_frontend_http_requests_total[5m])), 1e-9)",
          "legendFormat": "registered %"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top frontend routes (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (site, route) (rate(pacod_frontend_http_requests_total[5m])))",
          "legendFormat": "{{site}} \u00b7 {{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Edge & web up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=~\"caddy|frontend\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
