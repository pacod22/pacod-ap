# Caddyfile.local — LOCAL TEST EDGE. Never deploy this.
#
# The committed Caddyfile is production: vhosts bound to real hostnames
# (www.pacod.io, id.pacod.io, console.pacod.io), each terminating TLS with certs
# bind-mounted from /data/caddy/certs. None of that exists on a laptop, and a
# `tls` directive pointing at a missing file stops Caddy from booting — so a
# local run needs its own global options and sites without certificates. This
# is that file, paired with docker-compose.standalone.local.yml.
#
# What changes vs. production:
#   * Plain HTTP on ports, no TLS, no HTTP→HTTPS redirects.
#   * Hostnames become PORTS (:8080 for the main shell), because *.localhost
#     is resolved by browsers but not reliably by curl on macOS.
#   * The sites themselves are platform/caddy/ap.caddy, the same fragment as in
#     production; only their addresses differ. Its /monitoring route answers 502
#     until the optional monitoring module (pacod-grafana) runs.
#
# What deliberately does NOT change (do not "simplify" these):
#   * `flush_interval -1` and the 10-minute transport timeouts on every /api/*
#     block. That pair is what makes chat tokens arrive one at a time instead
#     of buffering into a single burst at the end — the exact behaviour you
#     came here to test. They are in the shared fragment.
#   * `handle /internal/*  { respond 404 }`, so the SvelteKit internal routes
#     stay off the edge locally too and you test the real routing table.
#   * The :9180 metrics listener, so a local Prometheus can scrape it.

{
    auto_https off
    admin off
    servers {
        metrics
    }
}

# Internal-only metrics listener — same as production. Not published to the
# host by docker-compose.standalone.local.yml; reachable as pacod-caddy:9180 on pacod-net.
:9180 {
    metrics /metrics
}

# pacod-ap's own site, the fragment the server and the full stack import too
# (platform/caddy/ap.caddy, mounted at /etc/caddy/sites). docker-compose.standalone.local.yml
# sets its address: AP_SITE=:8080 (the main shell; production www.pacod.io), with no
# certificates.
import /etc/caddy/sites/*.caddy

# The logs of the two sites below keep one-time values out: sign-in codes, their state, the
# hints at sign-out, and the tokens of account-email links (pacod-gw's Caddyfile does the same).
(redacted_log) {
    log {
        output stdout
        format filter {
            wrap console
            fields {
                request>uri query {
                    delete token
                    delete code
                    delete state
                    delete id_token_hint
                    delete login_hint
                    delete flow
                    delete next
                }
                request>headers>Referer delete
                resp_headers>Location delete
            }
        }
    }
}

# pacod-id's public listener: the issuer http://127.0.0.1:8070 (pacod-id.local.toml). Its
# internal listener (8071) is never routed.
:8070 {
    import redacted_log
    reverse_proxy pacod-id:8070 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# The gateway console (pacod-gw's gw-console on pacod-net), as http://127.0.0.1:13000. The
# console builds its origin from Host and X-Forwarded-Proto, which reverse_proxy passes; 502
# until `make gw-up`. The gateway's own Caddy does not run on the platform (`make gw-up` loads
# only pacod-gw's app file).
:13000 {
    import redacted_log
    encode zstd gzip
    reverse_proxy gw-console:3000 {
        flush_interval -1
    }
}
