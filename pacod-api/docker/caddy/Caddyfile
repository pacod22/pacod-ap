# Caddyfile — pacod-ap's server edge (pacod-caddy in docker-compose.standalone.yml).
#
# The global options and the sites only pacod-ap's own stack serves; pacod-ap's sites are
# platform/caddy/ap.caddy, imported below (the full stack imports the same fragment).
# Caddy is the single edge for the whole stack. Responsibilities:
#   1. Terminate TLS using certs from /etc/caddy/certs (mounted from /data/caddy/certs).
#   2. Redirect plain HTTP to HTTPS.
#   3. Disable response buffering so SSE tokens flush immediately.
#   4. Use generous timeouts so long agent turns don't get cut.
#   5. Route ALL traffic (including /api/*) through SvelteKit so the auth proxy hook can
#      convert session cookies to Bearer tokens before forwarding to the backends.
#      SvelteKit's handleApiProxy handles the admin vs. main api routing internally.
#   6. Serve pacod-id (id.pacod.io) and the gateway console (console.pacod.io).

{
    # Disable ACME / automatic HTTPS — certs are provided via tls directive below.
    auto_https off
    admin off
    # Enable Caddy's built-in Prometheus instrumentation (opt-in as of Caddy 2.5+).
    # Populates the default registry with caddy_http_requests_total{server,handler,
    # method,code}, caddy_http_request_duration_seconds, and request/response sizes
    # for ALL edge traffic across every vhost. Exposed on the internal :9180 listener
    # below (admin API stays off, so the metrics endpoint is a plain route handler).
    servers {
        metrics
    }
}

# Internal-only metrics listener. Plain HTTP (auto_https off), reachable ONLY over
# the pacod-net Docker network as pacod-caddy:9180 — it is NOT published to the host and
# never TLS-terminated, mirroring how the FastAPI /metrics stays off the public edge.
# Prometheus scrapes pacod-caddy:9180/metrics (see monitoring/prometheus/prometheus.yml.tpl).
:9180 {
    metrics /metrics
}

# The access log of every site here, pacod-ap's own (www) included: one file, JSON, with what a
# request may carry that must never be logged left out (pacod-demo/docs/LOGGING.md, section 6):
# sign-in codes and their state, the hints at sign-out, the tokens of account-email links,
# API keys in a query or a header, the Referer that can repeat any of them, and the Location of
# a redirect that hands one on. Caddy itself already leaves out Cookie, Set-Cookie and
# Authorization.
(redacted_logging) {
    log {
        output file /var/log/caddy.log
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                    delete code
                    delete state
                    delete next
                    delete flow
                    delete id_token_hint
                    delete login_hint
                    delete key
                }
                request>headers>Referer delete
                request>headers>X-Api-Key delete
                request>headers>X-Goog-Api-Key delete
                resp_headers>Location delete
            }
        }
    }
}

pacod.io {
    redir https://www.pacod.io{uri} permanent
}

# HTTP → HTTPS redirect for all hostnames.
http://www.pacod.io, http://id.pacod.io, http://console.pacod.io {
    redir https://{host}{uri} permanent
}

# The certificates and the access log of pacod-ap's site (platform/caddy/ap.caddy): the
# standalone compose file sets AP_SITE_OPTIONS to "import ap_tls_pacod_io". Defined before
# the import below, so the imported site can use it.
(ap_tls_pacod_io) {
    tls /etc/caddy/certs/pacod.io.full /etc/caddy/certs/pacod.io.key
    import redacted_logging
}

# pacod-ap's own site, the main shell (AP_SITE, www.pacod.io): the fragment the full stack
# imports too (platform/caddy/ap.caddy, mounted at /etc/caddy/sites).
import /etc/caddy/sites/*.caddy

# pacod-id's public listener: the issuer of the `pacod` realm (PACOD_ID_ISSUER). Its internal
# listener (8071) and metrics (9170) are never routed. The certificate must cover id.pacod.io.
id.pacod.io {
    tls /etc/caddy/certs/pacod.io.full /etc/caddy/certs/pacod.io.key

    import redacted_logging

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    reverse_proxy pacod-id:8070 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# The gateway console (pacod-gw's gw-console on pacod-net; PGW_CONSOLE_URL). The
# gateway's own Caddy does not run on the platform; its management API is never routed.
# The certificate must cover console.pacod.io.
console.pacod.io {
    tls /etc/caddy/certs/pacod.io.full /etc/caddy/certs/pacod.io.key

    import redacted_logging

    encode zstd gzip
    reverse_proxy gw-console:3000 {
        flush_interval -1
    }
}
