            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# The logs of pacod-id's and the gateway console's sites keep one-time values out: sign-in
# codes, their state, the hints at sign-out, the tokens of account-email links (as pacod-gw's
# own Caddyfile does). Same file as every other site, JSON.
(redacted_logging) {
    log {
        output file /var/log/caddy.log
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                    delete code
                    delete state
                    delete id_token_hint
                    delete login_hint
                    delete flow
                    delete next
                }
                request>headers>Referer delete
                resp_headers>Location delete
            }
        }
    }
}

# pacod-id's public listener: the issuer of the `pacod` realm (PACOD_ID_ISSUER). Its internal
# listener (8071) and metrics (9170) are never routed. The certificate must cover id.pacod.io.
id.pacod.io {
    tls /etc/caddy/certs/pacod.io.full /etc/caddy/certs/pacod.io.key

    import redacted_logging

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }

    reverse_proxy pacod-id:8070 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# The gateway console (pacod-gw's ui, alias gw-console on pacod-link; PGW_CONSOLE_URL). The
# gateway's own Caddy is switched off on the platform; its management API is never routed.
# The certificate must cover console.pacod.io.
console.pacod.io {
    tls /etc/caddy/certs/pacod.io.full /etc/caddy/certs/pacod.io.key

    import redacted_logging

    encode zstd gzip
    reverse_proxy gw-console:3000 {
        flush_interval -1
    }
}
