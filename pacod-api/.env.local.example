# .env.local.example — local test overrides. Copy to `.env.local` (gitignored):
#
#     cp .env.local.example .env.local     # `make up-local` also does this if missing
#
# This file holds ONLY the deltas from `.env`. It is deliberately not a copy of
# `.env.example` — a second full copy drifts, and then a local run silently
# tests a configuration nobody deployed. Everything not listed here (database
# credentials, provider API keys, JWT/session secrets, retrieval tuning) still
# comes from `.env`.
#
# It is loaded two ways by the local targets, both of which need it:
#   1. `--env-file .env --env-file .env.local`  → docker-compose ${VAR} interpolation
#      (this is what the LOCAL_* variables below drive; they are read by
#      docker-compose.local.yml, NOT by app/core/config.py)
#   2. `env_file: [.env, .env.local]` on the app services → the app's own Settings
# Later file wins, so every key here overrides the same key in `.env`.

# ---------------------------------------------------------------------------
# Application environment
# ---------------------------------------------------------------------------
# `development` is what enables the `dev-token-<user_id>` bearer tokens used by
# the smoke checks below — they are rejected outside it. People sign in through
# pacod-id in every environment.
APP_ENV=development
APP_LOG_LEVEL=DEBUG
# The log on stdout: text while APP_ENV=development (above) and this is unset; json for what a
# log collector reads. Files under APP_LOG_DIR are JSON either way (../pacod-demo/docs/LOGGING.md).
# APP_LOG_FORMAT=text
# Second lock on those dev tokens. `development` alone does not enable them: an
# APP_ENV that was never overridden on a server would otherwise expose an
# unauthenticated admin login. Both must be set. Local only — never in `.env`.
AUTH_ALLOW_DEV_TOKENS=true

# The MCP server fails closed without a shared secret; a fixed local value is
# fine here because the ap-mcp port is never published off the compose network.
MCP_SHARED_SECRET=local-dev-mcp-secret

# ---------------------------------------------------------------------------
# Public origins — as the BROWSER sees them, i.e. through the local Caddy edge.
# ---------------------------------------------------------------------------
# The frontend as the browser reaches it locally (links in outbound mail).
APP_PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Outbound email — off by default locally.
# ---------------------------------------------------------------------------
# A blank SMTP_USERNAME makes sending a no-op (app/services/email.py), so a
# local test run cannot mail real users from the shared account in `.env`.
# The verification/reset TOKEN is still minted in Redis, so you can complete the
# flow by reading the link out of the api logs:
#     make logs-local  |  grep -i 'verify-email\|reset-password'
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Cost control — a local run should not spend production money.
# ---------------------------------------------------------------------------
# These are env DEFAULTS; whatever is stored in app_settings by the admin LLM
# panel still wins at runtime for an already-seeded database.
# AGENT_PRIMARY_MODEL=anthropic/claude-haiku-4-5
# AGENT_CLASSIFIER_MODEL=anthropic/claude-haiku-4-5
# AGENT_PLANNER_MODEL=anthropic/claude-haiku-4-5

# The improvement loop and the newsletter run their own schedules and call the
# LLM without you asking. Their workers are always-on in the compose file, so
# turn the schedules off rather than the containers.
LOOP_SCHEDULE_ENABLED=false
LOOP_VERIFICATION_ENABLED=false

# Uncomment to take quotas out of the picture while testing.
# AGENT_QUOTA_DISABLED=true

# ---------------------------------------------------------------------------
# LOCAL_* — read by docker-compose.local.yml only (not by the application).
# ---------------------------------------------------------------------------
# `bge` is the real embedder and the default, so local retrieval behaves like
# production. `hash` swaps in random projections: the stack boots in seconds and
# needs no ~2 GB model download, but KB search returns nonsense. Use it only for
# testing paths that don't depend on retrieval quality — auth, quotas, admin
# CRUD.
# LOCAL_EMBEDDINGS_BACKEND=hash
#
# Once bge-m3 is in the pacod-hf-cache volume (after the first start), load it without asking
# HuggingFace: faster boots, and the stack starts offline. A first start with it set fails.
# EMBEDDINGS_HF_OFFLINE=1

# The gateway console as the browser reaches it locally (links from the admin pages).
GATEWAY_CONSOLE_URL=http://127.0.0.1:13000
# pacod-id's issuer as the browser reaches it locally (docker-compose.local.yml).
PACOD_ID_ISSUER=http://127.0.0.1:8070

# ---------------------------------------------------------------------------
# SEO / social — local overrides (read by docker-compose.local.yml only)
# ---------------------------------------------------------------------------
# Canonical + Open Graph URLs as the browser sees them locally. Left unset, a
# local page would advertise https://www.pacod.io as its canonical.
LOCAL_PACOD_SITE_URL=http://localhost:8080
# Keep the local stack out of search: robots.txt becomes `Disallow: /` and the
# sitemap comes back empty. Leave this false.
LOCAL_PACOD_SITE_INDEXING_ENABLED=false
# NB: every ad/measurement id, verification token and IndexNow key is blanked
# outright in docker-compose.local.yml rather than being overridable here — a
# local click must never fire a real pixel or land in production conversion
# data.

# Reverse-DNS crawler verification. Off locally so a laptop run makes no
# outbound DNS queries; local bot hits are recorded as `unknown`.
LOCAL_CRAWLER_VERIFY_ENABLED=false
