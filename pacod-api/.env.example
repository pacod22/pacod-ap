# `make ensure-env` copies this file to .env (gitignored — never commit it) and fills every
# generated secret left blank here (database password, session secret,
# tokens) with a fresh random value: scripts/env-init.sh. Values that come from outside —
# the search-provider keys, the newsletter's SMTP account — are set with
# `make secret-set NAME=<VAR>`. Never put a real value in this file.

# LLM calls go through the platform's gateway (pacod-gw). Its provider keys are NOT here:
# they are the gateway's (deploy/secrets/providers.env → make gw-bootstrap, or its console).
# Each service's gateway key comes from pacod-api/.env.gateway (make gw-bootstrap), never
# from this file.

# Web search (provider: auto | tavily | google)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-me
GOOGLE_SEARCH_API_KEY=replace-me
GOOGLE_SEARCH_CX=replace-me

# Client-side timeout per LLM request (seconds). A timed-out request is NEVER
# retried — the provider finishes and bills it regardless — so size it for the
# slowest legitimate call. The gateway's provider timeouts (600 s) sit above it.
LLM_TIMEOUT_SECONDS=180

# Database
POSTGRES_USER=pacod
POSTGRES_PASSWORD=
POSTGRES_DB=pacod

# Application
APP_ENV=development
# `dev-token-<user_id>` bearers grant admin+superuser with no password. They
# need BOTH `APP_ENV=development` and this flag, because APP_ENV above defaults
# to development.
# NEVER set this to true on a deployed host. Local runs get true from `.env.local`,
# which is loaded after `.env` and overrides it. Shipped explicitly rather than
# commented out: APP_ENV above still defaults to `development`, so a deploy that
# forgets to change it would otherwise have both locks open.
AUTH_ALLOW_DEV_TOKENS=false
APP_LOG_LEVEL=DEBUG
APP_LOG_DIR=/srv/logs
# Fernet key encrypting admin-panel-managed provider API keys at rest. Empty →
# key editing is disabled (panel shows read-only env status).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRETS_KEY=
# Answer languages (app/core/i18n.py): enabled set (CSV of bg | en) and the
# fallback language. Each agent narrows the set with its own languages.
PLATFORM_LANGUAGES=bg,en
PLATFORM_DEFAULT_LANGUAGE=en

# Configurable agent settings. The default profile (the `starter` demo agent) is
# seeded once from DEFAULT_PROFILE_* / AGENT_TOPIC_* (see app/core/config.py).
# DEFAULT_PROFILE_NAME=Starter Agent
# DEFAULT_PROFILE_LANGUAGES=en,bg
AGENT_LEGAL_YEAR=2026
AGENT_PRIMARY_MODEL=anthropic/claude-sonnet-5-5
AGENT_CLASSIFIER_MODEL=anthropic/claude-haiku-4-5
# Planner model. Blank → use AGENT_PRIMARY_MODEL. The planner only emits
# tool-selection JSON, so a fast model (e.g. anthropic/claude-haiku-4-5) cuts the
# serial pre-tool latency. Validate tool-choice quality with `make eval` first.
AGENT_PLANNER_MODEL=
# Max output tokens for the internal phases (compact JSON / classification),
# separate from the synthesis answer budget. Runtime-overridable from the panel.
AGENT_PLANNER_MAX_TOKENS=400
AGENT_CLASSIFIER_MAX_TOKENS=400
AGENT_SUGGESTIONS_MAX_TOKENS=300
# Follow-up suggestions model. Blank → use AGENT_CLASSIFIER_MODEL.
AGENT_SUGGESTIONS_MODEL=
# Provider prompt caching (Anthropic cache_control) on the static planner/synthesizer
# prefix. Default OFF (behaviour-preserving). Flip to true only after smoke-testing
# one chat turn end-to-end: no upstream error AND cache_read_input_tokens appear in
# the SSE `done` usage on a second identical-prefix call within 5 min.
AGENT_PROMPT_CACHE_ENABLED=false
# Send the `temperature` parameter in LLM requests. Set false for models that
# reject a non-default temperature (e.g. reasoning models) — it is then omitted
# from every agent LLM call. Runtime-overridable from the LLM-config panel.
AGENT_TEMPERATURE_ENABLED=true
# Reranking: rerank only the top N dense candidates (0 = all stage-1 candidates).
RETRIEVAL_RERANK_INPUT_K=0
# Dense-confidence early-exit: skip the cross-encoder when the top hits all score
# ≥ this (0 = off). Trades precision for latency — enable only after eval holds.
RETRIEVAL_RERANK_SCORE_THRESHOLD=0.0
# Default (tax) profile's Qdrant collection names. EVERY profile follows one
# convention — pacod_<slug>_kb / pacod_<slug>_kb_parents / pacod_<slug>_curated —
# and the default profile's slug is `taxes`, so leave these at the convention
# names unless you know why. Only the default profile's names are env-configurable
# (the others derive from their slug). On startup every profile is converged to
# its convention names via Qdrant aliases (no re-ingest); run
# `make migrate-collections` afterwards to rename the physical collections.
#   RETRIEVAL_COLLECTION_NAME  — authoritative base collection (may be an alias)
#   CURATED_COLLECTION_NAME    — separate lower-authority curated tier
RETRIEVAL_COLLECTION_NAME=pacod_starter_kb
CURATED_COLLECTION_NAME=pacod_starter_curated
# Embeddings/reranker service hardware (read by the embeddings container):
#   EMBEDDINGS_DEVICE=auto|cpu|cuda   (auto = GPU if present)
#   RERANKER_BACKEND=flag|onnx_int8   (onnx_int8 = ONNX Runtime cross-encoder, CPU path)
#   RERANKER_ONNX_PATH=               (dir of a pre-quantized INT8 ONNX model; blank exports fp32)
EMBEDDINGS_DEVICE=cpu
RERANKER_BACKEND=flag
RERANKER_ONNX_PATH=
AGENT_PER_USER_DAILY_TOKEN_LIMIT=100000
AGENT_PER_USER_PER_MINUTE_REQUESTS=10
# Hard kill-switch. Keep false so the runtime Dashboard toggle + per-user
# overrides govern quotas; set true only to bypass all quota checks (dev/test).
AGENT_QUOTA_DISABLED=false

# Semantic response cache — serve a cached answer when a new first-turn question
# is ≥ the cosine threshold similar to a previously answered one (skips the agent).
# Enable/threshold/TTL are runtime-overridable in the admin panel (no restart);
# these are the env defaults. Higher threshold = safer / fewer hits.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_SIMILARITY_THRESHOLD=0.90
RESPONSE_CACHE_TTL_SECONDS=86400
RESPONSE_CACHE_MAX_ENTRIES_PER_BUCKET=500

# Answer verification — second LLM pass that checks every number/claim
# against the tool context before the answer is streamed to the client.
# AGENT_VERIFICATION_COMPLEX_ONLY=true limits verification to requests the
# planner marks as is_complex=true (strategies, cross-border, multi-rule).
AGENT_VERIFICATION_ENABLED=false
AGENT_VERIFICATION_COMPLEX_ONLY=false

# Improvement loop ("Review process"). Env DEFAULTS — every knob below is
# runtime-overridable per profile from the admin Review-process panel.
# The daily schedule is OFF until enabled there; "Run now" works regardless.
LOOP_SCHEDULE_ENABLED=false
LOOP_SCHEDULE_HOUR=2
LOOP_SCHEDULE_MINUTE=0
LOOP_LOOKBACK_HOURS=24
LOOP_MAX_CONVERSATIONS=0
LOOP_CONCURRENCY=4
LOOP_TRIAGE_MODE=model
# Model panel. Blank A/judge/triage/remediation fall back to the agent models.
# B must be a DIFFERENT family than A (decorrelated errors) — blank does NOT fall
# back, it degrades the run to single-analyst mode and says so in the panel.
LOOP_ANALYSIS_MODE=dual
LOOP_ANALYSIS_MODEL_A=
LOOP_ANALYSIS_MODEL_B=openai/gpt-5.6-sol
LOOP_JUDGE_MODEL=
LOOP_REMEDIATION_MODEL=
LOOP_TRIAGE_MODEL=
LOOP_THINKING_BUDGET_TOKENS=4096
# Review calls are batch work with thinking on — GPT-5.x at 3000 + 4096 tokens
# routinely needs more than a minute. Same no-retry-on-timeout rule as above.
LOOP_LLM_TIMEOUT_SECONDS=600
LOOP_TRIAGE_MAX_TOKENS=600
LOOP_ANALYSIS_MAX_TOKENS=3000
LOOP_JUDGE_MAX_TOKENS=3000
LOOP_REMEDIATION_MAX_TOKENS=4000
LOOP_EVIDENCE_MAX_CONTEXT_CHARS=48000
LOOP_ENTAILMENT_REQUIRED=true
LOOP_CLUSTER_ENABLED=true
# Re-asks fixed questions through the LIVE agent (one full turn per case).
LOOP_VERIFICATION_ENABLED=false
LOOP_AUTO_INSERT_ENABLED=false
LOOP_META_RETIRE_ENABLED=false
# A request left `running` longer than this is assumed orphaned by a worker crash.
LOOP_RUN_STALE_HOURS=6

# Web search allowlist (comma-separated)
# Empty → web search returns nothing; set per agent from the admin panel.
WEB_SEARCH_ALLOWED_DOMAINS=

# Estimated per-search cost (USD) for the admin usage/cost view only — not billed.
WEB_SEARCH_COST_USD_TAVILY=0.008
WEB_SEARCH_COST_USD_GOOGLE=0.005

# Email / SMTP (verification + password-reset links). Default: Gmail.
# For a Gmail account, set SMTP_USERNAME to the address and SMTP_PASSWORD to a
# 16-char App Password (https://myaccount.google.com/apppasswords) — NOT the
# account password. Leave SMTP_USERNAME blank to disable sending (the newsletter
# then sends nothing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true          # STARTTLS on port 587
SMTP_USE_SSL=false         # set true + SMTP_PORT=465 for implicit TLS instead
EMAIL_FROM_ADDRESS= # blank → falls back to SMTP_USERNAME
EMAIL_FROM_NAME="PACOD Admin"
# Public base URL of the frontend — used to build the links in outbound mail
# (the newsletter's unsubscribe link). Account mail is pacod-id's
# (deploy/secrets/id.env: PID_SMTP_*, PID_EMAIL_FROM_*).
APP_PUBLIC_BASE_URL=https://www.pacod.io


# --- Private (server-only) -------------------------------------
# NOTE: The frontend's own service URLs (API_INTERNAL_URL / ADMIN_API_INTERNAL_URL)
# are hardcoded in docker-compose.yml's ap-frontend service; they are NOT read from
# here. Only the variables below are interpolated by docker-compose from this file.

# SvelteKit frontend session secret (used by the app-shell frontend).
# The docker-compose frontend service reads this as APP_SESSION_SECRET.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# GPU — AMD Radeon (ROCm). Only relevant on servers with an AMD GPU.
# GID of the host's 'render' group; required so the embeddings container can
# open /dev/dri/renderD* devices.  Find the correct value with:
#   getent group render | cut -d: -f3
# Typical value is 109 on Debian/Ubuntu with the amdgpu kernel driver.
RENDER_GID=992

# Ingestion
INGEST_DOC_CONCURRENCY=2   # lower = less memory, slower ingestion

# --- GPU overrides (AMD/ROCm) — uncomment on a GPU host to override the CPU
# defaults above. NOTE: HSA_OVERRIDE_GFX_VERSION is currently hardcoded to
# "10.3.0" in docker-compose.gpu.yml and is NOT interpolated from here.
# HSA_OVERRIDE_GFX_VERSION=10.3.0
# EMBEDDINGS_DEVICE=cuda
# RETRIEVAL_RERANK_INPUT_K=10

# ============================================================================
# SEO, social media and advertising (frontend)
# ============================================================================
# Read by the SvelteKit frontend at REQUEST time (lib/server/site-config.ts via
# $env/dynamic/private), so a change here needs `make up-ui` but no rebuild.
#
# PREFIXED KEYS. The site's keys are PACOD_<KEY> here; docker-compose.yml maps
# them into the `frontend` service under the neutral name (<KEY>). There are NO
# unprefixed SEO keys: an unprefixed GTM_ID etc. in this file is ignored.
# Adding a key here alone does nothing: it must also be wired in the compose
# `environment:` block (the frontend gets no env_file) and blanked in
# docker-compose.local.yml.
#
# BLANK MEANS OFF. An unset id renders no tag and loads no script, and the CSP
# in hooks.server.ts stays closed for that host. Configure only what you use.
#
# CONSENT. Nothing here loads until the visitor accepts the matching cookie
# category — "analytics" for measurement, "advertising" for the ad pixels. That
# gate is not optional and not configurable; see pacod-ui/frontend/src/lib/consent.ts.
#
# ---------------------------------------------------------------------------
# KEY REFERENCE (applies to the PACOD_ block below)
# ---------------------------------------------------------------------------
# Production defaults (also the compose `:-` fallbacks): PACOD
#   https://www.pacod.io — NOT the apex, which Caddy 301s to www, so a canonical
#   on pacod.io would point crawlers at a redirect. Account ids below have no
#   default.
# Identity
#   SITE_URL               Canonical origin, no trailing slash. Canonicals,
#                          hreflang, absolute og:image, sitemap.
#   SITE_NAME              og:site_name + page-title suffix.
#   SITE_OG_IMAGE          Default 1200x630 share image (frontend static/;
#                          sources in pacod-ui/frontend/design/og/).
#   SITE_INDEXING_ENABLED  false → robots.txt `Disallow: /`, empty sitemap,
#                          llms.txt and the IndexNow key 404. False on staging.
# Social profiles — full URLs; each renders a footer icon AND joins the
#   Organization `sameAs` JSON-LD. Blank until the account exists.
#   SOCIAL_{FACEBOOK,INSTAGRAM,YOUTUBE,TIKTOK,X,LINKEDIN,PINTEREST}_URL
#   SOCIAL_X_HANDLE        '@handle' for twitter:site / twitter:creator.
#   SOCIAL_WHATSAPP_NUMBER Digits, country code first, no '+' → wa.me/<n>.
#   SOCIAL_WHATSAPP_TEXT   Optional prefilled click-to-chat text.
# Domain ownership verification — the token only, not the whole <meta>:
#   GOOGLE_SITE_VERIFICATION     Search Console → Add property → HTML tag
#   BING_SITE_VERIFICATION       Bing Webmaster Tools → Add site → Meta tag
#                                (msvalidate.01; or import from Search Console)
#   YANDEX_SITE_VERIFICATION     Yandex Webmaster → Add site → Meta tag
#   PINTEREST_SITE_VERIFICATION  Pinterest → Settings → Claimed accounts → HTML tag
#   FACEBOOK_DOMAIN_VERIFICATION Meta Business → Brand Safety → Domains
#   TIKTOK_SITE_VERIFICATION     TikTok Business → Assets → Website verification
# Google
#   GTM_ID                 GTM-XXXXXXX. When set it OWNS the Google tags: GA4
#                          and Ads live in the container and the two ids below
#                          are NOT loaded separately (that would double-count).
#   GA_MEASUREMENT_ID      G-XXXXXXXXXX. Only used when GTM_ID is blank.
#   GOOGLE_ADS_ID          AW-XXXXXXXXX, plus the conversion action's label in
#   GOOGLE_ADS_CONVERSION_LABEL  (Goals → Conversions → action → Tag setup).
#                          Both are needed to report a conversion.
# Meta / TikTok / X
#   META_PIXEL_ID          Facebook + Instagram share one pixel.
#   META_APP_ID            fb:app_id share attribution only — not a tracker.
#   TIKTOK_PIXEL_ID        TikTok Ads → Assets → Events → Web Events.
#   X_PIXEL_ID             X universal website tag (base pixel) id.
#   X_EVENT_IDS            X conversions need a per-event id (tw-<pixel>-<event>),
#                          as a map: newsletter_subscribe=tw-xxx-yyy,sign_up=tw-xxx-zzz
#                          An event without an id is not sent to X.
# Yandex / Microsoft / Pinterest / LinkedIn
#   YANDEX_METRICA_ID      Metrica counter number (analytics consent). Goals are
#                          reported with reachGoal('<event name>').
#   MS_UET_TAG_ID          Microsoft Advertising UET tag id (advertising consent).
#   MS_CLARITY_ID          Microsoft Clarity project id (analytics consent).
#   PINTEREST_TAG_ID       Pinterest tag id (advertising consent).
#   LINKEDIN_PARTNER_ID    LinkedIn Insight tag partner id (advertising consent).
#   LINKEDIN_CONVERSION_IDS  Map like X_EVENT_IDS: sign_up=1234567,...
#   Conversion map event names: newsletter_subscribe, sign_up.
# IndexNow (Bing, Yandex, Seznam, Naver pick up changes within minutes)
#   INDEXNOW_KEY           8-128 chars of [a-zA-Z0-9-], e.g. `uuidgen | tr -d - | tr A-Z a-z`.
#                          Served at /<key>.txt; `make indexnow-ping` submits
#                          the live sitemap after a deploy. One key PER SITE.
#                          Public by design (it IS the served file), so each site
#                          ships a default; replace it if you ever need to rotate.
# Content
#   YOUTUBE_EMBED_ENABLED  Opens frame-src for youtube-nocookie.com. Separate
#                          from SOCIAL_YOUTUBE_URL (a footer link is not an embed).

# ============================================================================
# ===== PACOD — www.pacod.io (frontend service)
# ============================================================================
# --- Identity
PACOD_SITE_URL=https://www.pacod.io
PACOD_SITE_NAME=PACOD
PACOD_SITE_OG_IMAGE=/og-pacod.png
PACOD_SITE_INDEXING_ENABLED=true
# --- Social profiles
PACOD_SOCIAL_FACEBOOK_URL=
PACOD_SOCIAL_INSTAGRAM_URL=
PACOD_SOCIAL_YOUTUBE_URL=
PACOD_SOCIAL_TIKTOK_URL=
PACOD_SOCIAL_X_URL=
PACOD_SOCIAL_LINKEDIN_URL=
PACOD_SOCIAL_PINTEREST_URL=
PACOD_SOCIAL_X_HANDLE=
PACOD_SOCIAL_WHATSAPP_NUMBER=
PACOD_SOCIAL_WHATSAPP_TEXT=
# --- Domain ownership verification
PACOD_GOOGLE_SITE_VERIFICATION=
PACOD_BING_SITE_VERIFICATION=
PACOD_YANDEX_SITE_VERIFICATION=
PACOD_PINTEREST_SITE_VERIFICATION=
PACOD_FACEBOOK_DOMAIN_VERIFICATION=
PACOD_TIKTOK_SITE_VERIFICATION=
# --- Measurement & advertising tags
PACOD_GTM_ID=GTM-5ZXHZRCN
PACOD_GA_MEASUREMENT_ID=
PACOD_GOOGLE_ADS_ID=
PACOD_GOOGLE_ADS_CONVERSION_LABEL=
PACOD_META_PIXEL_ID=
PACOD_META_APP_ID=
PACOD_TIKTOK_PIXEL_ID=
PACOD_X_PIXEL_ID=
PACOD_X_EVENT_IDS=
PACOD_YANDEX_METRICA_ID=
PACOD_MS_UET_TAG_ID=
PACOD_MS_CLARITY_ID=
PACOD_PINTEREST_TAG_ID=
PACOD_LINKEDIN_PARTNER_ID=
PACOD_LINKEDIN_CONVERSION_IDS=
# --- IndexNow
PACOD_INDEXNOW_KEY=
# --- Content
PACOD_YOUTUBE_EMBED_ENABLED=false



# ============================================================================
# Crawler monitoring
# ============================================================================
# Records every visit from a search engine, AI crawler, SEO tool or social
# link-preview bot: which bot, which URL, which IP, which status.
#
# WHERE IT RUNS. Crawlers never reach FastAPI — the public vhost proxies only
# /health to Python and everything else (/, /agents/*, /robots.txt,
# /sitemap.xml) to SvelteKit. So the frontend classifies the User-Agent and
# posts rows in batches to ap-admin-api over pacod-net; `ap-api`/`ap-admin-api` only
# store and serve them.
#
# PRIVACY. Rows are written ONLY for requests already identified as bots, so no
# human IP address enters the table. Do not relax that into store-then-filter.

# Master switch for the two frontends. false → no crawler counter, no stored
# rows, no DNS lookups. (Set in docker-compose.yml's frontend environment blocks.)
#
# One thing it deliberately does NOT turn off: the `user_type="bot"` label on
# pacod_frontend_http_requests_total. Classifying the User-Agent is free and
# purely local, and that split is a correctness fix to a pre-existing metric —
# disabling crawler *recording* must not silently go back to counting Googlebot
# as an anonymous human on the Web-traffic dashboard.
CRAWLER_TRACKING_ENABLED=true

# Reverse-DNS verification of crawlers that publish a contract (Google, Bing,
# Yandex, Apple, Baidu). Confirms a "Googlebot" User-Agent really came from
# Google rather than a scraper wearing its name. Results are cached per IP for
# a week; false disables all DNS lookups.
CRAWLER_VERIFY_ENABLED=true

# Shared secret the frontend presents on POST /api/v1/crawler-visits/ingest.
# BLANK DISABLES INGEST: the endpoint returns 503 rather than accepting
# unauthenticated writes — unlike every other blank setting here, which merely
# turns a feature off. The dashboards keep working from the Prometheus counter;
# only the per-visit table goes dark. Generate with: openssl rand -base64 32
# ALSO authorizes the usage-analytics ingest (POST /api/v1/analytics/ingest/*),
# so with it blank the admin Analytics page gets no page requests / page views.
CRAWLER_INGEST_TOKEN=

# ---------- Usage analytics (admin → Monitoring → Analytics) ----------
# Requests + LLM usage per site (pacod / internal / unknown), per
# agent profile and per user. Raw rows (web_requests, page_views,
# llm_call_errors) are pruned daily by the improvement-loop worker; 0 keeps
# forever. usage_events / audit_log are never pruned (cost + chat history).
ANALYTICS_RETENTION_DAYS=180
# false → the api stops writing its per-request rows (kind='api').
ANALYTICS_API_REQUESTS_ENABLED=true
# Frontend switch (docker-compose.yml passes it to the frontend): false → no
# page-request rows and no page-view beacons are forwarded. Page views + dwell
# time are only ever collected from visitors who accepted ANALYTICS cookies.
ANALYTICS_TRACKING_ENABLED=true

# ---------- Per-user IP addresses + activity log (admin → Analytics → user) ----------
# Per account: every IP used (use count, first/last use) and a log of meaningful
# actions (login, logout, chat turn, chat deletion, password change)
# with IP, time and chat. The worker prunes activity older than N calendar
# months, and IPs not used for that long; 0 keeps forever. Admin-only.
USER_ACTIVITY_ENABLED=true
ACTIVITY_LOG_RETENTION_MONTHS=6

# Shared secret between the agent (api, improvement-loop-worker) and the MCP
# server, presented as X-MCP-Token. BLANK DENIES EVERY TOOL CALL (503): the
# MCP server otherwise answers any container on pacod-net with any profile's
# reference data. Set it on the same .env every service reads.
# Generate with: openssl rand -base64 32
MCP_SHARED_SECRET=

# How long per-visit rows are kept, pruned daily by improvement-loop-worker.
# 0 → keep forever. Well inside the 12 months the Privacy Policy declares for
# server logs, and these rows are bot traffic only.
CRAWLER_VISIT_RETENTION_DAYS=90
