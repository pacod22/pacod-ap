# Monitoring module — local secrets/config; the .tpl is committed, the rendered
# prometheus.yml is produced in-container at runtime (never on the host).
monitoring/.env
monitoring/prometheus/prometheus.yml

# Backup archives (contain all secrets) + local backup config — never commit.
/backups/
scripts/backup.env

# Build and tool output, anywhere in the tree.
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
node_modules/
.DS_Store

# Per-developer Claude Code settings (permission rules can quote commands verbatim).
.claude/settings.local.json
.claude/worktrees/

# Platform secrets: generated by `make secrets-init` / `make secret-set`, mode 0600.
# They hold pacod-id keys, gateway keys and provider keys — never commit.
/deploy/secrets/
pacod-api/.env.gateway
